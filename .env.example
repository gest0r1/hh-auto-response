# Backend
HH_CRM_DB_PATH=./data/hh_crm.sqlite3
HH_USER_AGENT=headhunter-crm-agent/0.1 (https://portfolio.viably.dev)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8000/oauth/hh/callback
HH_ACCESS_TOKEN=
HH_REFRESH_TOKEN=
HH_RESUME_ID=
HH_PROFILE_PATH=./data/profile.aleksandr.json
HH_COVER_LETTER_METHODOLOGY_PATH=./docs/cover-letter-methodology.md

# No-API public HH search defaults are CLI arguments; example:
# PYTHONPATH=backend python -m app.cli run-public-once --query 'React Python CRM' --per-query 20
# Optional browser profile for no-API form filling; stores HH login cookies locally, never commit it.
HH_BROWSER_USER_DATA_DIR=./data/hh-browser-profile

# Isolated Telegram review bot. Put real token into ./.secrets/hh_telegram.env, not into git.
HH_TELEGRAM_BOT_TOKEN=
HH_TELEGRAM_MIN_SCORE=80
HH_TELEGRAM_LIMIT=5
HH_TELEGRAM_PER_QUERY=20
HH_TELEGRAM_DRAFT_THRESHOLD=80
HH_TELEGRAM_SEND_ON_START=1
HH_TELEGRAM_QUERIES='React Python CRM|Telegram bot Python|AI automation developer|Full-stack developer удалённо'

# Dashboard
VITE_API_URL=http://localhost:8000
