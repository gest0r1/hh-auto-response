# Copy to .env and edit. .env is ignored by git.
# Python commands load .env automatically; shell wrappers source it without clobbering caller overrides.

# Core
PYTHONPATH=backend
HH_CRM_DB_PATH=./data/hh_crm.sqlite3
HH_PROFILE_PATH=./data/profile.local.json
HH_COVER_LETTER_METHODOLOGY_PATH=./docs/cover-letter-methodology.md
HH_USER_AGENT=hh-auto-response/0.1 (https://github.com/gest0r1/hh-auto-response)

# Optional HH OAuth API mode. Public search works without these.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8000/oauth/hh/callback
HH_ACCESS_TOKEN=
HH_REFRESH_TOKEN=
HH_RESUME_ID=

# Persistent Playwright profile. Stores HH and optional Google login cookies locally. Never commit it.
HH_BROWSER_USER_DATA_DIR=./data/hh-browser-profile

# Auto-apply defaults. SEND=0 is dry-run/fill only. Real HH submit needs SEND=1 and ALLOW_LIVE_SEND=1.
HH_AUTO_APPLY_SEND=0
HH_AUTO_APPLY_ALLOW_LIVE_SEND=0
HH_AUTO_APPLY_HEADLESS=1
HH_AUTO_APPLY_FETCH_DETAILS=1
HH_AUTO_APPLY_REQUIRE_DETAILS=1
HH_AUTO_APPLY_PER_QUERY=20
HH_AUTO_APPLY_DRAFT_THRESHOLD=85
HH_AUTO_APPLY_MIN_SCORE=85
HH_AUTO_APPLY_LIMIT=5
HH_AUTO_APPLY_DAILY_LIMIT=5
HH_AUTO_APPLY_QUERIES='Python Backend developer|FastAPI developer|Backend Python developer|AI Backend Engineer|LLM Backend Engineer|AgentOps engineer|RAG engineer'

# HH chat follow-up defaults. Real in-chat send needs SEND=1 and ALLOW_LIVE_SEND=1.
HH_CHAT_REPLY_SEND=0
HH_CHAT_REPLY_ALLOW_LIVE_SEND=0
HH_CHAT_EXTERNAL_SUBMIT=0
HH_CHAT_REPLY_HEADLESS=1
HH_CHAT_REPLY_LIMIT=5
HH_CHAT_REPLY_MAX_CHATS=160
HH_CHAT_REPLY_STATE_FILE=./data/hh_chat_reply_state.json

# HH chat external handoff alerts use the same Telegram-review bot.
# Set a real chat id here, or run /start in the bot so HH_TELEGRAM_CHAT_ID_PATH is populated.
HH_TELEGRAM_CHAT_ID=
HH_TELEGRAM_CHAT_ID_PATH=./data/hh_telegram_chat_id.txt
HH_TELEGRAM_OFFSET_PATH=./data/hh_telegram_offset.txt
HH_TELEGRAM_RUN_LOCK_PATH=./data/hh_telegram_run.lock

# Isolated Telegram-review bot. Prefer ./.secrets/hh_telegram.env for real token.
HH_TELEGRAM_BOT_TOKEN=
HH_TELEGRAM_MIN_SCORE=80
HH_TELEGRAM_LIMIT=5
HH_TELEGRAM_PER_QUERY=20
HH_TELEGRAM_DRAFT_THRESHOLD=80
HH_TELEGRAM_SEND_ON_START=1
HH_TELEGRAM_QUERIES='Python Backend developer|FastAPI developer|Backend Python developer|AI Backend Engineer|LLM Backend Engineer|Telegram bot Python developer'

# Dashboard
VITE_API_URL=http://localhost:8000
